import 'dart:typed_data';
import 'package:pdf/pdf.dart';
import 'package:pdf/widgets.dart' as pw;
import 'package:intl/intl.dart';

/// Generates the formal "Devis" (quote) PDF a company sends before
/// work begins — distinct from the invoice, which only exists after
/// completion. Real B2B work always has this document; it's what
/// makes the whole Grands Services flow feel like a genuine
/// professional engagement rather than a same-day repair.
class QuoteDocumentGenerator {
  static String generateQuoteId(String requestId) {
    final now = DateTime.now();
    final datePart = DateFormat('yyyyMMdd').format(now);
    final suffix = requestId.length >= 4
        ? requestId.substring(requestId.length - 4).toUpperCase()
        : requestId.toUpperCase();
    return 'DEVIS-$datePart-$suffix';
  }

  // Same Latin-1 safety net as InvoiceGenerator — free-text fields
  // (names, addresses, descriptions, notes) can contain anything.
  static String _safe(String input) {
    final buffer = StringBuffer();
    for (final rune in input.runes) {
      switch (rune) {
        case 0x2014:
        case 0x2013:
          buffer.write('-');
          break;
        case 0x2018:
        case 0x2019:
          buffer.write("'");
          break;
        case 0x201C:
        case 0x201D:
          buffer.write('"');
          break;
        case 0x2026:
          buffer.write('...');
          break;
        default:
          if (rune <= 0xFF) buffer.writeCharCode(rune);
      }
    }
    final result = buffer.toString().trim();
    return result.isEmpty ? '-' : result;
  }

  static Future<Uint8List> build({
    required String quoteId,
    required String companyName,
    required String companyCity,
    String companyPhone = '',
    required String clientName,
    required String clientAddress,
    required String categoryLabel,
    required String description,
    required double priceMAD,
    required bool materialsIncluded,
    double durationValue = 0,
    String durationUnit = '',
    int teamSize = 0,
    double depositPercent = 0,
    int warrantyMonths = 0,
    int validityDays = 7,
    List<Map<String, dynamic>> lineItems = const [],
    String notes = '',
    required DateTime issuedAt,
  }) async {
    final doc = pw.Document();
    final dateFmt = DateFormat('dd/MM/yyyy');
    final validUntil = issuedAt.add(Duration(days: validityDays));

    final safeCompanyName = _safe(companyName);
    final safeCompanyCity = _safe(companyCity);
    final safeCompanyPhone = _safe(companyPhone);
    final safeClientName = _safe(clientName);
    final safeClientAddress = _safe(clientAddress);
    final safeCategoryLabel = _safe(categoryLabel);
    final safeDescription = _safe(description);
    final safeQuoteId = _safe(quoteId);
    final safeNotes = _safe(notes);

    final durationLabel = durationValue > 0
        ? '${durationValue % 1 == 0 ? durationValue.toStringAsFixed(0) : durationValue.toStringAsFixed(1)} ${_safe(durationUnit)}'
        : null;

    doc.addPage(
      pw.Page(
        pageFormat: PdfPageFormat.a4,
        margin: const pw.EdgeInsets.all(40),
        build: (context) {
          return pw.Column(
            crossAxisAlignment: pw.CrossAxisAlignment.start,
            children: [
              // ---- Header ----
              pw.Row(
                mainAxisAlignment: pw.MainAxisAlignment.spaceBetween,
                children: [
                  pw.Column(
                    crossAxisAlignment: pw.CrossAxisAlignment.start,
                    children: [
                      pw.Text('CHI HAL',
                          style: pw.TextStyle(
                              fontSize: 22,
                              fontWeight: pw.FontWeight.bold,
                              color: PdfColor.fromInt(0xFF1D3576))),
                      pw.Text('Grands Services - plateforme de mise en relation',
                          style: const pw.TextStyle(fontSize: 9, color: PdfColors.grey700)),
                    ],
                  ),
                  pw.Column(
                    crossAxisAlignment: pw.CrossAxisAlignment.end,
                    children: [
                      pw.Text('DEVIS',
                          style: pw.TextStyle(
                              fontSize: 20,
                              fontWeight: pw.FontWeight.bold,
                              color: PdfColor.fromInt(0xFF1D3576))),
                      pw.Text('N° $safeQuoteId', style: const pw.TextStyle(fontSize: 10)),
                    ],
                  ),
                ],
              ),
              pw.SizedBox(height: 4),
              pw.Container(height: 2, color: PdfColor.fromInt(0xFFE0A62E)),
              pw.SizedBox(height: 18),

              // ---- Parties ----
              pw.Row(
                crossAxisAlignment: pw.CrossAxisAlignment.start,
                children: [
                  pw.Expanded(
                    child: pw.Column(
                      crossAxisAlignment: pw.CrossAxisAlignment.start,
                      children: [
                        pw.Text('PRESTATAIRE',
                            style: pw.TextStyle(
                                fontSize: 9, fontWeight: pw.FontWeight.bold, color: PdfColors.grey600)),
                        pw.SizedBox(height: 4),
                        pw.Text(safeCompanyName,
                            style: pw.TextStyle(fontSize: 12, fontWeight: pw.FontWeight.bold)),
                        pw.Text(safeCompanyCity, style: const pw.TextStyle(fontSize: 10)),
                        if (safeCompanyPhone.isNotEmpty && safeCompanyPhone != '-')
                          pw.Text(safeCompanyPhone, style: const pw.TextStyle(fontSize: 10)),
                      ],
                    ),
                  ),
                  pw.Expanded(
                    child: pw.Column(
                      crossAxisAlignment: pw.CrossAxisAlignment.start,
                      children: [
                        pw.Text('CLIENT',
                            style: pw.TextStyle(
                                fontSize: 9, fontWeight: pw.FontWeight.bold, color: PdfColors.grey600)),
                        pw.SizedBox(height: 4),
                        pw.Text(safeClientName,
                            style: pw.TextStyle(fontSize: 12, fontWeight: pw.FontWeight.bold)),
                        pw.Text(safeClientAddress, style: const pw.TextStyle(fontSize: 10)),
                      ],
                    ),
                  ),
                  pw.Expanded(
                    child: pw.Column(
                      crossAxisAlignment: pw.CrossAxisAlignment.start,
                      children: [
                        pw.Text('DATES',
                            style: pw.TextStyle(
                                fontSize: 9, fontWeight: pw.FontWeight.bold, color: PdfColors.grey600)),
                        pw.SizedBox(height: 4),
                        pw.Text('Emission : ${dateFmt.format(issuedAt)}',
                            style: const pw.TextStyle(fontSize: 10)),
                        pw.Text('Valable jusqu\'au : ${dateFmt.format(validUntil)}',
                            style: pw.TextStyle(
                                fontSize: 10,
                                fontWeight: pw.FontWeight.bold,
                                color: PdfColor.fromInt(0xFFB3541E))),
                      ],
                    ),
                  ),
                ],
              ),
              pw.SizedBox(height: 22),

              // ---- Project description ----
              pw.Text('OBJET DU PROJET',
                  style: pw.TextStyle(
                      fontSize: 9, fontWeight: pw.FontWeight.bold, color: PdfColors.grey600)),
              pw.SizedBox(height: 6),
              pw.Container(
                width: double.infinity,
                padding: const pw.EdgeInsets.all(12),
                decoration: pw.BoxDecoration(
                  color: PdfColors.grey100,
                  borderRadius: const pw.BorderRadius.all(pw.Radius.circular(4)),
                ),
                child: pw.Column(
                  crossAxisAlignment: pw.CrossAxisAlignment.start,
                  children: [
                    pw.Text(safeCategoryLabel,
                        style: pw.TextStyle(fontSize: 11, fontWeight: pw.FontWeight.bold)),
                    pw.SizedBox(height: 4),
                    pw.Text(safeDescription, style: const pw.TextStyle(fontSize: 10, lineSpacing: 2)),
                  ],
                ),
              ),
              pw.SizedBox(height: 18),

              // ---- Terms grid ----
              pw.Text('CONDITIONS',
                  style: pw.TextStyle(
                      fontSize: 9, fontWeight: pw.FontWeight.bold, color: PdfColors.grey600)),
              pw.SizedBox(height: 8),
              pw.Wrap(
                spacing: 28,
                runSpacing: 10,
                children: [
                  _term('Materiaux', materialsIncluded ? 'Inclus dans le prix' : 'Non inclus'),
                  if (durationLabel != null) _term('Delai d\'execution', durationLabel),
                  if (teamSize > 0) _term('Equipe', '$teamSize technicien${teamSize > 1 ? 's' : ''}'),
                  if (depositPercent > 0)
                    _term('Acompte requis', '${depositPercent.toStringAsFixed(0)}% a la confirmation'),
                  if (warrantyMonths > 0) _term('Garantie', '$warrantyMonths mois'),
                ],
              ),
              pw.SizedBox(height: 18),

              // ---- Line items ----
              if (lineItems.isNotEmpty) ...[
                pw.Table(
                  border: pw.TableBorder.all(color: PdfColors.grey400, width: 0.6),
                  columnWidths: const {0: pw.FlexColumnWidth(6), 1: pw.FlexColumnWidth(2)},
                  children: [
                    pw.TableRow(
                      decoration: const pw.BoxDecoration(color: PdfColors.grey200),
                      children: [
                        _cell('Poste', bold: true),
                        _cell('Montant', bold: true),
                      ],
                    ),
                    ...lineItems.map((item) {
                      final label = _safe(item['label'] as String? ?? '');
                      final amount = (item['amountMAD'] as num?)?.toDouble() ?? 0;
                      return pw.TableRow(children: [
                        _cell(label),
                        _cell('${amount.toStringAsFixed(0)} MAD'),
                      ]);
                    }),
                  ],
                ),
                pw.SizedBox(height: 14),
              ],

              // ---- Total ----
              pw.Align(
                alignment: pw.Alignment.centerRight,
                child: pw.Container(
                  padding: const pw.EdgeInsets.symmetric(horizontal: 18, vertical: 12),
                  decoration: pw.BoxDecoration(
                    color: PdfColor.fromInt(0xFF1D3576),
                    borderRadius: const pw.BorderRadius.all(pw.Radius.circular(4)),
                  ),
                  child: pw.Row(
                    children: [
                      pw.Text('MONTANT TOTAL : ',
                          style: pw.TextStyle(
                              fontSize: 13, fontWeight: pw.FontWeight.bold, color: PdfColors.white)),
                      pw.Text('${priceMAD.toStringAsFixed(0)} MAD',
                          style: pw.TextStyle(
                              fontSize: 15, fontWeight: pw.FontWeight.bold, color: PdfColors.white)),
                    ],
                  ),
                ),
              ),

              if (safeNotes.isNotEmpty && safeNotes != '-') ...[
                pw.SizedBox(height: 16),
                pw.Text('REMARQUES',
                    style: pw.TextStyle(
                        fontSize: 9, fontWeight: pw.FontWeight.bold, color: PdfColors.grey600)),
                pw.SizedBox(height: 4),
                pw.Text(safeNotes, style: const pw.TextStyle(fontSize: 10)),
              ],

              pw.SizedBox(height: 30),

              // ---- Signature block ----
              pw.Row(
                crossAxisAlignment: pw.CrossAxisAlignment.start,
                children: [
                  pw.Expanded(
                    child: pw.Column(
                      crossAxisAlignment: pw.CrossAxisAlignment.start,
                      children: [
                        pw.Text('Le Prestataire',
                            style: pw.TextStyle(fontSize: 10, fontWeight: pw.FontWeight.bold)),
                        pw.SizedBox(height: 40),
                        pw.Container(height: 0.6, width: 160, color: PdfColors.grey400),
                      ],
                    ),
                  ),
                  pw.Expanded(
                    child: pw.Column(
                      crossAxisAlignment: pw.CrossAxisAlignment.start,
                      children: [
                        pw.Text('Le Client - Bon pour accord',
                            style: pw.TextStyle(fontSize: 10, fontWeight: pw.FontWeight.bold)),
                        pw.Text('(date et signature)',
                            style: const pw.TextStyle(fontSize: 8, color: PdfColors.grey600)),
                        pw.SizedBox(height: 28),
                        pw.Container(height: 0.6, width: 160, color: PdfColors.grey400),
                      ],
                    ),
                  ),
                ],
              ),

              pw.SizedBox(height: 24),
              pw.Divider(color: PdfColors.grey400),
              pw.SizedBox(height: 6),
              pw.Text(
                  'Devis genere via CHI HAL. Prix ferme, valable jusqu\'a la date indiquee ci-dessus. '
                  'Sans reponse du client avant cette date, ce devis est considere comme expire.',
                  style: const pw.TextStyle(fontSize: 8, color: PdfColors.grey600)),
            ],
          );
        },
      ),
    );

    return doc.save();
  }

  static pw.Widget _term(String label, String value) {
    return pw.Column(
      crossAxisAlignment: pw.CrossAxisAlignment.start,
      children: [
        pw.Text(label, style: const pw.TextStyle(fontSize: 8.5, color: PdfColors.grey600)),
        pw.SizedBox(height: 2),
        pw.Text(value, style: pw.TextStyle(fontSize: 10.5, fontWeight: pw.FontWeight.bold)),
      ],
    );
  }

  static pw.Widget _cell(String text, {bool bold = false}) {
    return pw.Padding(
      padding: const pw.EdgeInsets.all(8),
      child: pw.Text(text,
          style: pw.TextStyle(
              fontSize: 9.5, fontWeight: bold ? pw.FontWeight.bold : pw.FontWeight.normal)),
    );
  }
}